diff --git a/src/nuwro.cc b/src/nuwro.cc
index 8cc86e2..464a558 100755
--- a/src/nuwro.cc
+++ b/src/nuwro.cc
@@ -28,6 +28,23 @@
 #include "kaskada7.h"
 #include "sfevent.h"
 #include "Analyser1.h"
+#include <ctime>
+
+// Pythia6 (used for hadronization) has its own RANMAR generator which NuWro never
+// seeded, so every NuWro process replayed the same Pythia random sequence (default
+// seed 19780503). Harmless for one long run, but correlates the hadronic final states
+// of many short grid jobs. Seed it from random_seed (RANMAR accepts 0..900000000);
+// MRPY(2)=0 forces re-initialization on the next PYR call.
+extern "C" {
+  extern struct { int mrpy[6]; double rrpy[100]; } pydatr_;
+}
+static void seed_pythia6(int random_seed)
+{
+	long s = random_seed > 1 ? random_seed : (long) time(NULL);
+	pydatr_.mrpy[0] = (int) (s % 900000000L);
+	pydatr_.mrpy[1] = 0;
+	cout << "Pythia6 random seed MRPY(1) = " << pydatr_.mrpy[0] << endl;
+}
 #include "geomy.h"
 #include "ff.h"
 #include "hist.h"
@@ -143,6 +160,7 @@ void NuWro::init (int argc, char **argv)
 	if(a.progress)
 		_progress.open(a.progress);
 	frandom_init(p.random_seed);
+	seed_pythia6(p.random_seed);
 
 	frame_bottom();
 
